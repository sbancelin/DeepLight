# Python
__pycache__/
*.py[cod]
*.pyo

# Environnements
.venv/
venv/
env/

# Build / packaging
build/
dist/
*.egg-info/

# Qt / IDE
*.log
.vscode/
.idea/

# Tests / caches
.pytest_cache/
.mypy_cache/

# Données locales / acquisitions
data/
output/
exports/
tmp/
temp/

# Vendor binaries. DeepLight loads none of its own: the drivers it uses come
# from the SDK installed on the acquisition PC (Kinesis, PI GCS, NI-DAQmx,
# PICam), whose paths live in the config file. Committing a vendor DLL would
# redistribute someone else's binary, which an OSI-licensed release cannot do
# without checking the terms.
*.dll
*.so
*.dylib

# OS
.DS_Store
Thumbs.db

.claude/

# Local machine configuration (see config.py). Each acquisition PC has its own;
# it must never be committed.
deeplight.toml